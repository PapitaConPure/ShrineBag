<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>ShrineBag</AssemblyName>
		<RootNamespace>ShrineBag</RootNamespace>
		<Version>1.0.0</Version>
		<GameDir Condition="'$(GameDir)' == ''">D:\Archivos de Programa\SteamLibrary\steamapps\common\Risk of Rain 2</GameDir>
		<ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\Risk of Rain 2_Data\Managed</ManagedDir>
		<BepInExDir Condition="'$(BepInExDir)' == ''">C:\Users\Papita con puré\AppData\Roaming\com.kesomannen.gale\riskofrain2\profiles\Testing\BepInEx</BepInExDir>
		<MMHOOKDir Condition="'$(MMHOOKDir)' == ''">C:\Users\Papita con puré\AppData\Roaming\com.kesomannen.gale\riskofrain2\profiles\Testing\BepInEx\plugins\RiskofThunder-HookGenPatcher\MMHOOK</MMHOOKDir>
		<EnableRiskOfOptions Condition="'$(EnableRiskOfOptions)' == ''">true</EnableRiskOfOptions>
	</PropertyGroup>

	<PropertyGroup Condition="'$(EnableRiskOfOptions)' == 'true'">
		<DefineConstants>$(DefineConstants);RISK_OF_OPTIONS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.3.1.275-r.0" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="UnityEngine">
			<HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
		</Reference>
		<Reference Include="BepInEx">
			<HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="MMHOOK_Assembly-CSharp">
			<HintPath>$(MMHOOKDir)\MMHOOK_Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(EnableRiskOfOptions)' == 'true'">
		<Reference Include="RiskOfOptions">
			<HintPath>$(BepInExDir)\plugins\Rune580-Risk_Of_Options\RiskOfOptions\RiskOfOptions.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="assets\icon.png" LogicalName="ShrineBag.icon.png" />
	</ItemGroup>
</Project>
